APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailtrap Sending API is the active mailer for now (see MAILTRAP_API_TOKEN
# below). NAV and SMTP stay configured — switch MAIL_MAILER to "nav" or
# "smtp" whenever you're ready to move off Mailtrap.
MAIL_MAILER=mailtrap
MAILTRAP_API_TOKEN=
MAIL_SCHEME=null
MAIL_URL=
# SMTP fallback (also used by NavTransport if NAV fails mid-request). If
# using Mailtrap over SMTP instead of the API: host=live.smtp.mailtrap.io,
# port=587, username=apismtp@mailtrap.io, password=<your Mailtrap API token>.
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS="hello@demomailtrap.com"
MAIL_FROM_NAME="${APP_NAME}"
MIC_CC_EMAIL=

POSTMARK_API_KEY=
RESEND_API_KEY=

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google reCAPTCHA v3 (leave blank to disable — forms fall back to rate limiting only)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ClamAV virus scanning for uploaded documents
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# AI document extraction (KYC document parsing)
AI_DOCUMENT_API_KEY=
AI_DOCUMENT_ENDPOINT=https://api.openai.com/v1/chat/completions

# Minutes an issued sticker is expected to take before it's flagged overdue
STICKER_TURNAROUND_MINUTES=30

# Microsoft NAV/Business Central SOAP mail codeunit — leave NAV_MAIL_ENABLED=false
# until the codeunit functions listed below exist on the NAV side.
NAV_MAIL_ENABLED=false
NAV_MAIL_WSDL=
NAV_MAIL_FUNCTION=SendMail
NAV_NTLM_DOMAIN=
NAV_NTLM_USERNAME=
NAV_NTLM_PASSWORD=
NAV_FUNCTION_CERTIFICATE_EMAIL=SendCertificateEmail
NAV_FUNCTION_QUOTATION_EMAIL=SendQuotationEmail
NAV_FUNCTION_CLAIM_EMAIL=SendClaimEmail
