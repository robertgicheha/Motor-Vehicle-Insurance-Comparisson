APP_NAME="LOLC Motor Vehicle Insurance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lolc_motor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true whenever APP_URL is https:// (i.e. everywhere except local dev)
# so the session cookie is never sent over a plain HTTP connection.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailtrap Sending API is the active mailer for now — real emails (claims,
# sticker issuance, user account creation, quotation generation, etc.) go
# out through Mailtrap while NAV's codeunit functions aren't live yet.
# NAV and SMTP stay fully configured below; switch MAIL_MAILER back to "nav"
# or "smtp" whenever you're ready, nothing else needs to change.
MAIL_MAILER=mailtrap
MAILTRAP_API_TOKEN=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_SCHEME=
MAIL_URL=
# SMTP fallback: also Mailtrap, reached via SMTP instead of the Sending API.
# This is what NavTransport falls back to if NAV ever fails mid-request, and
# it's a ready-made alternative if you'd rather set MAIL_MAILER=smtp instead
# of the API-based "mailtrap" transport — same account, same inbox, either
# way.
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=
MIC_CC_EMAIL=

POSTMARK_API_KEY=
RESEND_API_KEY=

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

AI_DOCUMENT_API_KEY=
AI_DOCUMENT_ENDPOINT=https://api.openai.com/v1/chat/completions

STICKER_TURNAROUND_MINUTES=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENWEATHER_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# Google reCAPTCHA v3 (leave blank to disable — forms fall back to rate limiting only)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Microsoft NAV/Business Central SOAP mail codeunit.
# Leave NAV_MAIL_ENABLED=false until the codeunit functions below exist on the
# NAV side — the app falls back to normal Laravel Mail for every send while
# this is off, so filling in the WSDL/credentials alone does not change any
# live behavior.
NAV_MAIL_ENABLED=false
NAV_MAIL_WSDL=http://nav.example.local:18093/MIC-KE/WS/MIC%20Global%20Risks/Codeunit/hrdatahandler
NAV_MAIL_FUNCTION=SendMail
NAV_NTLM_DOMAIN=
NAV_NTLM_USERNAME=
NAV_NTLM_PASSWORD=
# Codeunit function names this app calls for each email type — confirm these
# against what NAV actually implements, or override here if they differ.
NAV_FUNCTION_CERTIFICATE_EMAIL=SendCertificateEmail
NAV_FUNCTION_QUOTATION_EMAIL=SendQuotationEmail
NAV_FUNCTION_CLAIM_EMAIL=SendClaimEmail

CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
