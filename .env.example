MAILTRAP_API_TOKEN=5183c8959aff7559c71979436128f6df
MAIL_FROM_ADDRESS="hello@demomailtrap.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_SCHEME=
MAIL_URL=
# SMTP fallback: also Mailtrap, reached via SMTP instead of the Sending API.
# This is what NavTransport falls back to if NAV ever fails mid-request, and
# it's a ready-made alternative if you'd rather set MAIL_MAILER=smtp instead
# of the API-based "mailtrap" transport — same account, same inbox, either
# way.
