@push('scripts')
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
function quotationsPage() {
    return {
        search: '',
        statusFilter: '',
        applyModal: false,
        selectedUser: '',
        applyUserName: '',

        // Analytics data passed from controller
        companyData: @json($analytics['by_company'] ?? []),
        trendData:   @json($analytics['trend'] ?? []),

        init() {
            this.$nextTick(() => {
                this.buildCompanyChart();
                this.buildPremiumChart();
                this.buildTrendChart();
            });
        },

        openApplyFor(userId, userName) {
            this.selectedUser  = userId;
            this.applyUserName = userName;
            this.applyModal    = true;
        },

        rowVisible(el) {
            // Alpine x-show based filtering (client-side, current page only)
            const row = el;
            const searchStr   = (row.dataset.search  || '').toLowerCase();
            const statusStr   = (row.dataset.status  || '').toLowerCase();
            const matchSearch = !this.search || searchStr.includes(this.search.toLowerCase());
            const matchStatus = !this.statusFilter || statusStr === this.statusFilter.toLowerCase();
            return matchSearch && matchStatus;
        },

        filterTable() {
            // triggers x-show re-evaluation
        },

        buildCompanyChart() {
            const ctx = document.getElementById('companyChart');
            if (!ctx) return;
            const labels = this.companyData.map(d => d.company);
            const counts = this.companyData.map(d => d.count);
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: 'Quotations',
                        data: counts,
                        backgroundColor: ['#1E40AF', '#F59E0B', '#10B981', '#8B5CF6', '#EF4444'],
                        borderRadius: 6,
                        borderSkipped: false,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0, font: { size: 11 }, color: '#9ca3af' },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        x: {
                            ticks: { font: { size: 11, weight: '600' }, color: '#6b7280' },
                            grid: { display: false }
                        }
                    }
                }
            });
        },

        buildPremiumChart() {
            const ctx = document.getElementById('premiumChart');
            if (!ctx) return;
            const labels  = this.companyData.map(d => d.company);
            const amounts = this.companyData.map(d => d.total_premium || 0);
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels,
                    datasets: [{
                        data: amounts,
                        backgroundColor: ['#1E40AF', '#F59E0B', '#10B981', '#8B5CF6', '#EF4444'],
                        borderWidth: 2,
                        borderColor: '#fff',
                        hoverOffset: 6,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { font: { size: 11 }, color: '#6b7280', boxWidth: 10, padding: 12 }
                        }
                    }
                }
            });
        },

        buildTrendChart() {
            const ctx = document.getElementById('trendChart');
            if (!ctx) return;
            const labels = this.trendData.map(d => d.date);
            const counts = this.trendData.map(d => d.count);
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Quotations',
                        data: counts,
                        borderColor: '#1E40AF',
                        backgroundColor: 'rgba(30,64,175,0.08)',
                        borderWidth: 2.5,
                        pointBackgroundColor: '#1E40AF',
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        fill: true,
                        tension: 0.4,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0, font: { size: 11 }, color: '#9ca3af' },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        x: {
                            ticks: { font: { size: 10 }, color: '#9ca3af', maxRotation: 45 },
                            grid: { display: false }
                        }
                    }
                }
            });
        }
    }
}
</script>
@endpush
</x-app-layout>